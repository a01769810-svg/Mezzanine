<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Conveyor.
    Model: DOBOT Conveyor Belt Kit (official spec).
    Official dimensions: 700 x 215 x 60 mm = 0.700 x 0.215 x 0.060 m.
    Position (from EstacionMezzanine.dxf): table-frame LL corner = (0.385, 0.302, 0).
    Notes: effective_travel ~= 0.600 m, payload 0.5 kg, max speed 0.120 m/s.
    Official STEP/SolidWorks file not yet located (see layout_params.yaml).
  -->
  <xacro:property name="conveyor_size_x" value="0.700"/>
  <xacro:property name="conveyor_size_y" value="0.215"/>
  <xacro:property name="conveyor_size_z" value="0.060"/>

  <xacro:macro name="mz_conveyor" params="parent:=table_origin x:=0.385 y:=0.302 z:=0.000">
    <link name="conveyor_base">
      <visual>
        <origin xyz="${conveyor_size_x/2} ${conveyor_size_y/2} ${conveyor_size_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${conveyor_size_x} ${conveyor_size_y} ${conveyor_size_z}"/>
        </geometry>
        <material name="mz_conveyor_belt"/>
      </visual>
      <collision>
        <origin xyz="${conveyor_size_x/2} ${conveyor_size_y/2} ${conveyor_size_z/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${conveyor_size_x} ${conveyor_size_y} ${conveyor_size_z}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${parent}_to_conveyor_base" type="fixed">
      <parent link="${parent}"/>
      <child link="conveyor_base"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
